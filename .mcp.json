{
  "mcpServers": {
    "dart": {
      "command": ".fvm/flutter_sdk/bin/dart",
      "args": [
        "mcp-server",
        "--force-roots-fallback"
      ]
    },
    "chrome-devtools": {
      "command": "bash",
      "args": [
        "tool/run_chrome_devtools_mcp.sh"
      ]
    },
    "firebase": {
      "command": "bash",
      "args": [
        "tool/run_firebase_mcp.sh"
      ]
    }
  }
}
