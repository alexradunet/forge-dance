{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chrome (Debug)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "Web Server (Agent)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "toolArgs": ["--web-hostname=127.0.0.1", "--web-port=7357"]
    },
    {
      "name": "Linux Desktop (Debug)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "linux"
    },
    {
      "name": "Android (Debug)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "android"
    },
    {
      "name": "Chrome (Profile)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "profile"
    },
    {
      "name": "Chrome (Release)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "release"
    },
    {
      "name": "All Tests",
      "type": "dart",
      "request": "launch",
      "program": "test/"
    },
    {
      "name": "Current Test File",
      "type": "dart",
      "request": "launch",
      "program": "${file}"
    }
  ]
}
