{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "forge: checks (CI pipeline)",
      "type": "shell",
      "command": "bash tool/checks.sh",
      "group": {"kind": "test", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "forge: codegen",
      "dependsOn": ["forge: localization", "forge: build_runner"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "forge: localization",
      "type": "shell",
      "command": "fvm dart run easy_localization:generate -f keys -o locale_keys.g.dart --source-dir assets/translations",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "forge: build_runner",
      "type": "shell",
      "command": "fvm dart run build_runner build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "forge: build_runner watch",
      "type": "shell",
      "command": "fvm dart run build_runner watch",
      "isBackground": true,
      "group": "build",
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "problemMatcher": {
        "owner": "dart",
        "pattern": {"regexp": "^$"},
        "background": {"activeOnStart": true, "beginsPattern": ".", "endsPattern": "Synchronizing|Watching for file changes"}
      }
    },
    {
      "label": "forge: analyze",
      "type": "shell",
      "command": "fvm flutter analyze",
      "group": "test",
      "problemMatcher": ["$dart-analyze"]
    },
    {
      "label": "forge: test",
      "type": "shell",
      "command": "fvm flutter test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "forge: build web (release)",
      "type": "shell",
      "command": "fvm flutter build web --release --wasm",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "forge: android in Orca",
      "type": "shell",
      "command": "bash tool/run_orca_android.sh",
      "isBackground": true,
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "problemMatcher": {
        "owner": "dart",
        "pattern": {"regexp": "^$"},
        "background": {"activeOnStart": true, "beginsPattern": "Attaching|Starting Forge Dance", "endsPattern": "The Flutter DevTools debugger and profiler"}
      }
    },
    {"label": "forge: capture android", "type": "shell", "command": "bash tool/capture_android_emulator.sh", "problemMatcher": []},
    {
      "label": "forge: integration test (web)",
      "type": "shell",
      "command": "bash tool/check_integration.sh",
      "group": "test",
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "forge: web quality (Lighthouse)",
      "type": "shell",
      "command": "bash tool/check_web_quality.sh",
      "group": "test",
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {"label": "forge: pub get", "type": "shell", "command": "fvm flutter pub get", "problemMatcher": []}
  ]
}
